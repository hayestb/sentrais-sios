# ── Database (Neon) ───────────────────────────────────────────────────────────
# Use the -pooler hostname for the app (PgBouncer — lower connection count on Vercel)
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Use the direct hostname for migrations only (drizzle.config.ts)
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Clerk Auth ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxx
CLERK_SECRET_KEY=sk_live_xxxx
CLERK_WEBHOOK_SECRET=whsec_xxxx

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/command-center
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/command-center

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ── AI (Vercel AI Gateway — no API key needed when using OIDC on Vercel) ──────
# Only needed for local dev outside of vercel env pull:
# ANTHROPIC_API_KEY=sk-ant-...

# ── Email (optional) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=governance@sentrais.com

# ── Calendar OAuth (optional — for Google/Outlook sync) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
CALENDAR_ENCRYPTION_KEY=32-char-random-string-here
